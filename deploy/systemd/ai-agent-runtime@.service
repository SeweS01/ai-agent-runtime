[Unit]
Description=AI Agent Runtime daemon for AgentInstance %i
After=local-fs.target

[Service]
Type=notify
ExecStart=%h/.local/bin/ai-agent-runtime@%i --config %h/.config/ai-agent-runtime/instances/%i.toml serve
Restart=always
RestartSec=2s
WatchdogSec=30s
RuntimeDirectory=ai-agent-runtime/%i
RuntimeDirectoryMode=0700
# tmux sockets live below TMUX_TMPDIR in this directory. A full daemon stop
# must not unlink the socket while the Telegram Agent and Codex are still live.
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=true
# Runtime must verify exact wrapper cwd/executable through /proc.  A private
# /tmp mount makes cross-namespace /proc symlinks unreadable on the production
# kernel.  tmux isolation is provided by the per-AgentInstance TMUX_TMPDIR.
PrivateTmp=false

[Install]
WantedBy=default.target
