[Unit]
Description=AI Agent Runtime daemon for AgentInstance %i
After=local-fs.target

[Service]
Type=notify
ExecStart=%h/.local/bin/ai-agent-runtime --config %h/.config/ai-agent-runtime/instances/%i.toml serve
Restart=always
RestartSec=2s
WatchdogSec=30s
RuntimeDirectory=ai-agent-runtime/%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
